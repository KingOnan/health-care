# DB
DATABASE_URL=mysql+asyncmy://user:user@localhost:3400/health_care
DATABASE_ECHO=false

# 타임존
TIMEZONE=Asia/Seoul

# 혈압 정상 기준 (mmHg)
BLOOD_PRESSURE_SYSTOLIC_NORMAL_MAX=120
BLOOD_PRESSURE_DIASTOLIC_NORMAL_MAX=80

# 혈당 정상 기준 (mg/dL)
BLOOD_SUGAR_FASTING_NORMAL_MAX=100
BLOOD_SUGAR_POST_MEAL_NORMAL_MAX=140

# JWT 설정
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=525600

# CORS 허용
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://192.168.0.2:5173

# 업로드 파일 저장 경로
UPLOAD_DIR=uploads
